{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whiteout",
  "version": "0.1.0",
  "identifier": "io.github.sinerla-development.whiteout",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Whiteout",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://images.steamusercontent.com; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Save editor for The Long Dark",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMEM1M0I1MDg5NkU2RkQKUldUOTVwWUl0Vk1NejZISjJIQUtHUjdOTGt2UXBZVnVZRnJjaWVxSTFBRVhhQkRseVhhU0x4VmEK",
      "endpoints": ["https://github.com/Sinerla-Development/Whiteout/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
